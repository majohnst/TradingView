// ============================================================================
//  XSP Daily Lotto — Strategy
//  0DTE spike-fill options strategy with TradersPost webhook support
//  Pine Script v6
//
//  TRADE LOGIC:
//    Bullish: buy CALL at PM_LOW strike when price spikes DOWN to that level.
//             Target T1↑ / T2↑ above PM_HIGH.  Stop below PM_LOW.
//    Bearish: buy PUT at PM_HIGH strike when price spikes UP to that level.
//             Target T1↓ / T2↓ below PM_LOW.  Stop above PM_HIGH.
//
//  OPTION COST FILTER:
//    Required spike depth = Max Premium / Cost-per-Point.
//    Entry only fires when the underlying has moved far enough past the PM
//    level that the strike at that level is at least (max premium / cost rate)
//    points OTM — meaning the option should cost approximately maxPremium or less.
//    Two dashed "trigger zone" lines show exactly where price must trade to fire.
//
//  SENTIMENT / PORTABILITY:
//    "Sentiment Symbol" drives the directional bias (bull/bear/neutral) and
//    supplies premarket range data when the chart symbol has no PM bars.
//    XSP / SPY  →  ES1! or CME_MINI:MES1!
//    IWM / small caps  →  CME_MINI:M2K1!
//    DIA / industrials →  CME_MINI:MYM1!
//    NDX / QQQ         →  CME_MINI:MNQ1!
//    Single-stock ETFs  →  use the related sector future or leave blank
//
//  TRADERSPOST:
//    One alert() fires per entry (buy/sell JSON with strike & expiry hints)
//    One alert() fires per exit (action:exit).
//    Set the TradingView alert to "Any alert() function call" and paste your
//    TradersPost webhook URL.  Leave the message body blank — the script sends
//    the full JSON automatically.
//
//  PARTIAL LADDER EXIT:
//    Uses qty_percent for TP1.  With a single contract TradingView rounds 50%
//    to 1 contract and closes the full position at T1.  Use 2+ contracts (set
//    Contracts per Trade) for true half-at-T1 / half-at-T2 ladder behavior.
// ============================================================================

//@version=6
strategy("XSP Daily Lotto",
         overlay            = true,
         max_boxes_count    = 20,
         max_labels_count   = 50,
         default_qty_type   = strategy.fixed,
         default_qty_value  = 2,
         pyramiding         = 0,
         calc_on_every_tick = false)

// ── Input Groups ──────────────────────────────────────────────────────────────
var string GRP_SENT = "Sentiment Symbol"
var string GRP_LVLS = "Level Structure"
var string GRP_OPT  = "Option Entry Filter"
var string GRP_EXIT = "Exit Settings"
var string GRP_SES  = "Session"
var string GRP_EXEC = "TradersPost"
var string GRP_VIS  = "Visuals"

// ── Sentiment Symbol ──────────────────────────────────────────────────────────
string sentSymbol = input.symbol("CME_MINI:ES1!", "Sentiment Symbol",
    tooltip = "Futures or ETF whose direction drives the bull/bear bias and premarket range. " +
              "XSP/SPY → ES1!.  IWM/small caps → M2K1!.  DIA/industrials → MYM1!.  NDX/QQQ → MNQ1!.  " +
              "Leave as ES1! for any SPX-correlated chart.",
    group   = GRP_SENT)
float sentThresh = input.float(0.10, "Neutral band (%)",
    minval  = 0.0, maxval = 2.0, step = 0.05,
    tooltip = "±% change from prior close.  Within band = neutral (yellow box, both directions allowed).",
    group   = GRP_SENT) / 100
string tradeDir = input.string("Both", "Trade Direction",
    options = ["Both", "Bull Only (Calls)", "Bear Only (Puts)"],
    tooltip = "Both: sentiment determines direction (bull→calls, bear→puts, neutral→either).  " +
              "Bull/Bear Only: hard filter regardless of sentiment.",
    group   = GRP_SENT)

// ── Level Structure ───────────────────────────────────────────────────────────
bool  snapEnabled = input.bool(true,  "Snap levels to nearest option strike",
    tooltip = "Rounds all levels to the ATR-derived strike grid (0.5 / 1 / 2.5 / 5 pt).",
    group   = GRP_LVLS)
float lvl1Mult    = input.float(0.25, "T1 multiplier (× PM range)",
    minval  = 0.05, step = 0.05,
    tooltip = "T1 = PM_HIGH + range × mult (bull) or PM_LOW − range × mult (bear).",
    group   = GRP_LVLS)
float lvl2Mult    = input.float(0.50, "T2 multiplier (× PM range)",
    minval  = 0.05, step = 0.05, group = GRP_LVLS)
bool  showOR      = input.bool(true,  "Show Opening Range box", group = GRP_LVLS)
int   orMins      = input.int(15,     "Opening Range (minutes)",
    options = [5, 10, 15, 30], group = GRP_LVLS)

// ── Option Entry Filter ───────────────────────────────────────────────────────
float maxPremium = input.float(0.10, "Max Option Premium ($)",
    minval  = 0.01, step = 0.01,
    tooltip = "Maximum debit you are willing to pay per option.  " +
              "Entry fires only when the spike carries the underlying far enough past the strike that the option " +
              "should cost approximately this amount or less.  " +
              "Trigger level = PM level ± (Max Premium ÷ Cost per Point).",
    group   = GRP_OPT)
float costPerPt = input.float(0.10, "Estimated $ cost / point OTM",
    minval  = 0.01, step = 0.01,
    tooltip = "Approximate dollar value reduction per point the underlying is beyond the strike at entry.  " +
              "0DTE XSP: ~$0.10 per point on a normal-IV day.  Raise to 0.15-0.20 on high-IV (VIX > 20) days.  " +
              "Lower to 0.05-0.07 on very low-IV days.",
    group   = GRP_OPT)
bool requireOR = input.bool(true, "Require OR break before entry",
    tooltip = "ON (recommended): entry only fires after the Opening Range has formed AND price has already " +
              "broken in the spike direction — below OR low for calls, above OR high for puts.  " +
              "Filters out spikes that happen before a clear directional commitment from the OR.",
    group   = GRP_OPT)
int maxPerDir = input.int(1, "Max entries per direction per day",
    minval  = 1, maxval = 3,
    tooltip = "Hard limit on how many call or put entries can fire each calendar day.  " +
              "Set to 1 for disciplined single-trade days.",
    group   = GRP_OPT)
int   optMultiplier = input.int(100, "Contract multiplier (shares per contract)",
    minval  = 1,
    tooltip = "Standard US equity / index options = 100.  Multiply contracts × multiplier gives total shares for P&L.  " +
              "Mini options or non-standard contracts may differ.",
    group   = GRP_OPT)
float tp1OptionPrice = input.float(1.00, "Target option price at T1 ($)",
    minval  = 0.05, step = 0.05,
    tooltip = "Expected option value (per share) when the position hits T1.  " +
              "Sets the underlying exit level at strike + this value (calls) or strike − this value (puts).  " +
              "For 0DTE near expiry the option price ≈ its intrinsic value, so a $1 target means the underlying " +
              "needs to be $1 past the strike.  Adjust based on observed option prices at typical T1 levels.",
    group   = GRP_OPT)
float tp2OptionPrice = input.float(2.00, "Target option price at T2 ($)",
    minval  = 0.05, step = 0.05,
    tooltip = "Expected option value at T2.  Same logic as T1 — underlying must be this many dollars past the strike.",
    group   = GRP_OPT)

// ── Exit Settings ─────────────────────────────────────────────────────────────
// Stop is always at the strike (call strike for longs, put strike for shorts).
// If price returns to the strike the option is ATM and worth less than the premium paid.
// Loss = maxPremium × optMultiplier × contracts = exact option debit at risk.
int   contracts = input.int(2, "Contracts per Trade",
    minval  = 1,
    tooltip = "Use 2+ for T1/T2 ladder exits.  With 1 contract the full position closes at T1.",
    group   = GRP_EXIT)
bool  tp1En     = input.bool(true, "Partial exit at T1", group = GRP_EXIT)
float tp1Pct    = input.float(50.0, "T1 exit size (%)",
    minval  = 10.0, maxval = 100.0, step = 10.0,
    tooltip = "Percentage of the position to close at T1.  Remainder runs to T2 or stop.",
    group   = GRP_EXIT)
bool  tp2En     = input.bool(true, "Final exit at T2", group = GRP_EXIT)
bool  itmCheckEn  = input.bool(true, "Close if ITM before expiry",
    tooltip = "At the configured minutes-before-EOD window, checks if the open position is ITM.  " +
              "If it is — and not deep-ITM on a cash-settled instrument — closes for whatever intrinsic value remains.  " +
              "Prevents a modestly-profitable position from expiring worthless when TP targets were never reached.",
    group   = GRP_EXIT)
int   itmOffset   = input.int(30, "  Minutes before EOD to check",
    minval  = 5, maxval = 60,
    tooltip = "How many minutes before the EOD force-close time to run the ITM check.  Default 30 = check at 3:15 when EOD is 3:45.",
    group   = GRP_EXIT)
bool  skipDeepItm = input.bool(true, "  Skip close if deep ITM (cash-settled hold)",
    tooltip = "ON: if the position is deeply ITM (beyond the threshold below), skip the ITM close and let it settle.  " +
              "XSP and SPX are European cash-settled — no assignment risk, so holding a way-ITM option to expiry is safe.  " +
              "OFF: always close at the check window if ITM, regardless of depth.",
    group   = GRP_EXIT)
float deepItmPts  = input.float(2.0, "  Deep ITM threshold (points)",
    minval  = 0.5, step = 0.5,
    tooltip = "Position is considered deep ITM when the underlying is this many points past the strike.  " +
              "At 1-pt snap grid, 2 pts = 2 strikes deep ITM.  Raise for higher-ATR instruments.",
    group   = GRP_EXIT)
bool  eodEn     = input.bool(true, "EOD force-close",
    tooltip = "ON: strategy closes any open position at the time below.  " +
              "OFF: position is left to expire (option goes worthless) — avoids the broker close fee and does not consume a day trade.  " +
              "Turn OFF when the trade is clearly a loser and paying to close costs more than letting it expire worthless.",
    group   = GRP_EXIT)
int   eodHr     = input.int(15, "  EOD force-close hour (NY)",   minval = 12, maxval = 15, group = GRP_EXIT)
int   eodMn     = input.int(45, "  EOD force-close minute (NY)", minval = 0,  maxval = 59, group = GRP_EXIT)

// ── Session ───────────────────────────────────────────────────────────────────
int entryLockHr = input.int(11, "No new entries after hour (NY)",
    minval  = 9, maxval = 15,
    tooltip = "Entries blocked at or after this NY hour.  Default 11 AM — 0DTE spike opportunities are front-loaded in the first 90 minutes.",
    group   = GRP_SES)
int entryLockMn = input.int(30, "No new entries after minute (NY)",
    minval  = 0, maxval = 59, group = GRP_SES)

// ── TradersPost ───────────────────────────────────────────────────────────────
bool useMarket = input.bool(true, "Use Market Orders",
    tooltip = "ON: no price field sent, TradersPost submits a market order (recommended for options).  " +
              "OFF: includes the underlying close price as a reference limit — broker may ignore for options.",
    group   = GRP_EXEC)

// ── Visuals ───────────────────────────────────────────────────────────────────
bool showLabels = input.bool(true, "Show open label",   group = GRP_VIS)
bool showStatus = input.bool(true, "Show status label", group = GRP_VIS)

// ── Time Helpers (New York) ───────────────────────────────────────────────────
int  nyH   = hour(time, "America/New_York")
int  nyM   = minute(time, "America/New_York")
int  nyMin = nyH * 60 + nyM

bool isPM    = nyMin >= 240 and nyMin < 570       // 4:00 AM – 9:30 AM
bool isMkt   = nyMin >= 570 and nyMin < 960       // 9:30 AM – 4:00 PM
bool isOR    = isMkt and nyMin < (570 + orMins)
bool pmStart = bar_index > 0 and isPM  and not isPM[1]
bool mktOpen = bar_index > 0 and isMkt and not isMkt[1]
bool orEnds  = bar_index > 0 and not isOR and isOR[1] and isMkt
bool newDay  = ta.change(time("D")) != 0

bool afterLock      = nyH > entryLockHr or (nyH == entryLockHr and nyM >= entryLockMn)
bool isEod          = nyH > eodHr or (nyH == eodHr and nyM >= eodMn)
bool inWindow       = isMkt and not afterLock and not isEod
bool isItmCheckTime = isMkt and nyMin >= (eodHr * 60 + eodMn - itmOffset) and not isEod

// ── Premarket Range (chart symbol) ───────────────────────────────────────────
var float pmHigh  = na
var float pmLow   = na
var float pmClose = na

if pmStart
    pmHigh  := high
    pmLow   := low
    pmClose := close
else if isPM
    pmHigh  := math.max(nz(pmHigh, high), high)
    pmLow   := math.min(nz(pmLow,  low),  low)
    pmClose := close

// ── Sentiment Symbol Premarket (fallback range source) ───────────────────────
// When the chart symbol has no PM bars (e.g. CBOE-derived indices), the
// sentiment symbol's premarket range is scaled to chart-price units at open.
float sH15 = nz(request.security(sentSymbol, "15", high),  close)
float sL15 = nz(request.security(sentSymbol, "15", low),   close)
float sC15 = nz(request.security(sentSymbol, "15", close), close)

var float sentPmHigh  = na
var float sentPmLow   = na
var float sentPmClose = na

if pmStart
    sentPmHigh  := sH15
    sentPmLow   := sL15
    sentPmClose := sC15
else if isPM
    sentPmHigh  := math.max(nz(sentPmHigh,  sH15), sH15)
    sentPmLow   := math.min(nz(sentPmLow,   sL15), sL15)
    sentPmClose := sC15

// ── Opening Range ─────────────────────────────────────────────────────────────
var float orHigh     = na
var float orLow      = na
var int   orStartBar = na

if mktOpen
    orHigh     := high
    orLow      := low
    orStartBar := bar_index
else if isOR
    orHigh := math.max(nz(orHigh, high), high)
    orLow  := math.min(nz(orLow,  low),  low)

// ── Sentiment Calculation ─────────────────────────────────────────────────────
float sentNow = nz(request.security(sentSymbol, "15", close),    close)
float sentPrv = nz(request.security(sentSymbol, "D",  close[1]), sentNow)
float sentPct = sentPrv > 0 ? (sentNow - sentPrv) / sentPrv : 0.0
bool  isBull  = sentPct >  sentThresh
bool  isBear  = sentPct < -sentThresh

color sentFill   = isBull ? color.new(color.green,  85) : isBear ? color.new(color.red,    85) : color.new(color.yellow, 85)
color sentBorder = isBull ? color.green : isBear ? color.red : color.yellow
string sentText  = isBull ? "BULL" : isBear ? "BEAR" : "NEUTRAL"

// ── Prior Day Fallback ────────────────────────────────────────────────────────
float xD_H = nz(request.security(syminfo.tickerid, "D", high[1]),  close)
float xD_L = nz(request.security(syminfo.tickerid, "D", low[1]),   close)
float xD_C = nz(request.security(syminfo.tickerid, "D", close[1]), close)

// ── Strike Snap ───────────────────────────────────────────────────────────────
float xspATR  = nz(request.security(syminfo.tickerid, "D", ta.atr(14)), 5.0)
float snapInt = xspATR < 4.0 ? 0.5 : xspATR < 8.0 ? 1.0 : xspATR < 15.0 ? 2.5 : 5.0
snap(v) => snapEnabled ? math.round(v / snapInt) * snapInt : v

// ── Lock Levels at Market Open ────────────────────────────────────────────────
var float lockedPivot = na
var float lockedHigh  = na
var float lockedLow   = na
var float lockedRange = na

if mktOpen
    bool  hasXSP  = not na(pmHigh)    and pmHigh    > nz(pmLow,    pmHigh)
    bool  hasSent = not na(sentPmHigh) and sentPmHigh > nz(sentPmLow, sentPmHigh)
    float sScale  = sentPmClose > 0 ? close / sentPmClose : 1.0
    float h = hasXSP ? pmHigh  : hasSent ? sentPmHigh * sScale : xD_H
    float l = hasXSP ? pmLow   : hasSent ? sentPmLow  * sScale : xD_L
    float c = hasXSP ? pmClose : hasSent ? close : xD_C
    lockedPivot := snap((h + l + c) / 3)
    lockedHigh  := snap(h)
    lockedLow   := snap(l)
    lockedRange := h - l

lockedPivot := nz(lockedPivot, snap((xD_H + xD_L + xD_C) / 3))
lockedHigh  := nz(lockedHigh,  snap(xD_H))
lockedLow   := nz(lockedLow,   snap(xD_L))
lockedRange := math.max(nz(lockedRange, xD_H - xD_L), syminfo.mintick)

// ── Target Levels (gamma proxy extensions) ────────────────────────────────────
float t2up = snap(lockedHigh + lockedRange * lvl2Mult)
float t1up = snap(lockedHigh + lockedRange * lvl1Mult)
float t1dn = snap(lockedLow  - lockedRange * lvl1Mult)
float t2dn = snap(lockedLow  - lockedRange * lvl2Mult)

// ── Intraday Range Tracker (for OR breakout detection) ───────────────────────
var float dayLow  = na
var float dayHigh = na
if newDay
    dayLow  := na
    dayHigh := na
if isMkt
    dayLow  := na(dayLow)  ? low  : math.min(dayLow,  low)
    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)

// OR breakout flags: once OR has formed, track if price has ever broken each boundary.
// Bulls need an OR breakdown (price below OR low = spike trap → buy call).
// Bears need an OR breakup  (price above OR high = false pop → buy put).
bool orFormed    = not na(orLow) and not isOR and isMkt
bool orBrokeDown = orFormed and not na(dayLow)  and dayLow  < nz(orLow,  lockedLow)
bool orBrokeUp   = orFormed and not na(dayHigh) and dayHigh > nz(orHigh, lockedHigh)

// ── Option Cost Filter ────────────────────────────────────────────────────────
// min spike depth (points) = maxPremium / costPerPt
// At this depth the strike is (minSpike) points OTM → estimated cost = maxPremium.
float minSpike = maxPremium / costPerPt

// Trigger levels drawn on chart — price must trade here to fire entry.
float bullTrigger = lockedLow  - minSpike   // spike-down target (call entry)
float bearTrigger = lockedHigh + minSpike   // spike-up target (put entry)

// ── Daily Trade Counter ───────────────────────────────────────────────────────
var int  bullCount    = 0
var int  bearCount    = 0
var bool itmCheckFired = false
if newDay
    bullCount     := 0
    bearCount     := 0
    itmCheckFired := false

// ── Direction Gate ────────────────────────────────────────────────────────────
// "Both" mode: bull sentiment = calls only; bear = puts only; neutral = either.
bool sentNeut = not isBull and not isBear
bool dirBull  = tradeDir == "Bull Only (Calls)" or (tradeDir == "Both" and (isBull or sentNeut))
bool dirBear  = tradeDir == "Bear Only (Puts)"  or (tradeDir == "Both" and (isBear or sentNeut))

// ── Entry Conditions ──────────────────────────────────────────────────────────
bool spikeToLow  = isMkt and low  <= bullTrigger
bool spikeToHigh = isMkt and high >= bearTrigger

bool bullORgate = not requireOR or orBrokeDown
bool bearORgate = not requireOR or orBrokeUp

bool noPosition = strategy.position_size == 0
bool canBull    = inWindow and noPosition and dirBull and bullCount < maxPerDir and bullORgate
bool canBear    = inWindow and noPosition and dirBear and bearCount < maxPerDir and bearORgate

bool goLong  = canBull and spikeToLow
bool goShort = canBear and spikeToHigh

// ── Persistent Exit Levels (set at entry, held across bars until trade closes) ─
var float exitTP1  = na
var float exitTP2  = na
var float exitStop = na
var float entryStrk = na

// ── Entry Orders ──────────────────────────────────────────────────────────────
string exitJson = '{"ticker":"' + syminfo.ticker + '","action":"exit"}'

// effQty: contracts × optMultiplier so Pine P&L reflects the 100-shares-per-contract reality.
// Entry uses a limit at strike + maxPremium (long) / strike − maxPremium (short).
//   Fill happens when price bounces back above/below that level after the spike.
//   Stop at the strike exactly → loss distance = maxPremium → loss $ = maxPremium × effQty.
// TP levels use option intrinsic targets, not underlying gamma proxy extensions.
//   TP underlying level = strike ± tp1/tp2OptionPrice  (≈ intrinsic value for 0DTE near expiry).
//   Gain $ at TP1 = (tp1OptionPrice − maxPremium) × effQty × (tp1Pct/100).
int effQty = contracts * optMultiplier

if goLong
    bullCount  := bullCount + 1
    entryStrk  := snap(lockedLow)
    exitTP1    := entryStrk + tp1OptionPrice
    exitTP2    := entryStrk + tp2OptionPrice
    exitStop   := entryStrk           // stop AT call strike — option ATM, worth < premium
    string cs     = str.tostring(entryStrk, "#.##")
    string bBase  = '{"ticker":"' + syminfo.ticker + '","action":"buy","sentiment":"bullish","optionType":"call","strike":' + cs + ',"expiry":"0DTE","quantity":' + str.tostring(contracts) + '}'
    string bLimit = '{"ticker":"' + syminfo.ticker + '","action":"buy","sentiment":"bullish","optionType":"call","strike":' + cs + ',"expiry":"0DTE","price":"' + str.tostring(bullTrigger, format.mintick) + '","quantity":' + str.tostring(contracts) + '}'
    string bMsg   = useMarket ? bBase : bLimit
    strategy.entry("Long", strategy.long, qty = effQty, limit = entryStrk + maxPremium, comment = "CALL@" + cs)
    alert(bMsg, alert.freq_once_per_bar)

if goShort
    bearCount  := bearCount + 1
    entryStrk  := snap(lockedHigh)
    exitTP1    := entryStrk - tp1OptionPrice
    exitTP2    := entryStrk - tp2OptionPrice
    exitStop   := entryStrk           // stop AT put strike — option ATM, worth < premium
    string ps     = str.tostring(entryStrk, "#.##")
    string sBase  = '{"ticker":"' + syminfo.ticker + '","action":"sell","sentiment":"bearish","optionType":"put","strike":' + ps + ',"expiry":"0DTE","quantity":' + str.tostring(contracts) + '}'
    string sLimit = '{"ticker":"' + syminfo.ticker + '","action":"sell","sentiment":"bearish","optionType":"put","strike":' + ps + ',"expiry":"0DTE","price":"' + str.tostring(bearTrigger, format.mintick) + '","quantity":' + str.tostring(contracts) + '}'
    string sMsg   = useMarket ? sBase : sLimit
    strategy.entry("Short", strategy.short, qty = effQty, limit = entryStrk - maxPremium, comment = "PUT@" + ps)
    alert(sMsg, alert.freq_once_per_bar)

// ── Cancel Pending Limit Entries After Entry Lock ────────────────────────────
// If the spike limit order hasn't filled by the entry cutoff, kill it.
// strategy.close_all() does NOT cancel pending entries — cancel_all() is needed.
if afterLock and not afterLock[1]
    strategy.cancel_all()

// ── Exit Orders ───────────────────────────────────────────────────────────────
// Stop always active at the strike level (no stopEn toggle — for options, the
// strike IS the only meaningful stop: option is ATM and worth less than paid).
// Stop on TP2 only — TP1 is a straight limit.
// If stop fires before T1: TP2 closes remainder; TP1 auto-cancels.
// If T1 fires first: TP2 covers the remaining half at T2 or stop.
if strategy.position_size > 0
    float sl = not na(exitStop) ? exitStop : na
    if tp1En and tp2En
        strategy.exit("Long TP1", from_entry="Long", qty_percent=tp1Pct, limit=exitTP1,          comment_profit="T1")
        strategy.exit("Long TP2", from_entry="Long",                     limit=exitTP2, stop=sl,  comment_profit="T2", comment_loss="Stop@Strike")
    else if tp1En
        strategy.exit("Long TP1", from_entry="Long", limit=exitTP1, stop=sl, comment_profit="T1", comment_loss="Stop@Strike")
    else if tp2En
        strategy.exit("Long TP2", from_entry="Long", limit=exitTP2, stop=sl, comment_profit="T2", comment_loss="Stop@Strike")
    else
        strategy.exit("Long Stop", from_entry="Long", stop=sl, comment_loss="Stop@Strike")

if strategy.position_size < 0
    float sl = not na(exitStop) ? exitStop : na
    if tp1En and tp2En
        strategy.exit("Short TP1", from_entry="Short", qty_percent=tp1Pct, limit=exitTP1,         comment_profit="T1")
        strategy.exit("Short TP2", from_entry="Short",                     limit=exitTP2, stop=sl, comment_profit="T2", comment_loss="Stop@Strike")
    else if tp1En
        strategy.exit("Short TP1", from_entry="Short", limit=exitTP1, stop=sl, comment_profit="T1", comment_loss="Stop@Strike")
    else if tp2En
        strategy.exit("Short TP2", from_entry="Short", limit=exitTP2, stop=sl, comment_profit="T2", comment_loss="Stop@Strike")
    else
        strategy.exit("Short Stop", from_entry="Short", stop=sl, comment_loss="Stop@Strike")

// ── ITM-30 Check ─────────────────────────────────────────────────────────────
// Runs once per day when the check window opens (default 30 min before EOD).
// Purpose: capture remaining intrinsic value when TP targets were never reached.
//
// Close decision matrix:
//   OTM          → skip (let expire worthless — EOD toggle handles this)
//   ITM, shallow → close to capture value and avoid wasting the fill
//   ITM, deep    → skip close when skipDeepItm ON (cash-settled, no assignment risk)
//
// "Deep ITM" = underlying is ≥ deepItmPts points past the strike.  On a
// cash-settled instrument (XSP, SPX) holding a way-ITM option to expiry is safe
// — no shares delivered, settles to intrinsic at the 4 PM fixing price.

float itmDepth = strategy.position_size > 0 and not na(entryStrk) ? close - entryStrk : strategy.position_size < 0 and not na(entryStrk) ? entryStrk - close : 0.0
bool  posIsItm = itmDepth > 0.0

if itmCheckEn and isItmCheckTime and not itmCheckFired and strategy.position_size != 0
    itmCheckFired := true
    bool holdForCash = skipDeepItm and itmDepth >= deepItmPts
    if posIsItm and not holdForCash
        strategy.close_all(comment = "ITM-30")
        alert(exitJson, alert.freq_once_per_bar)

// ── EOD Force-Close ───────────────────────────────────────────────────────────
// When eodEn is OFF the position is left to expire — no close fee, no day trade.
if eodEn and isEod and strategy.position_size != 0
    strategy.cancel_all()
    strategy.close_all(comment = "EOD")
    alert(exitJson, alert.freq_once_per_bar)

// ── Exit Alert (non-EOD close) ────────────────────────────────────────────────
var int prevClosed = 0
if strategy.closedtrades > prevClosed
    prevClosed := strategy.closedtrades
    alert(exitJson, alert.freq_once_per_bar)

// ── Premarket Box ─────────────────────────────────────────────────────────────
var box pmBox = na
if pmStart
    box.delete(pmBox)
    pmBox := box.new(bar_index, high, bar_index + 1, low, bgcolor=sentFill, border_color=sentBorder, border_width=1)
if (isPM or isMkt) and not na(pmBox)
    box.set_top(pmBox,          nz(pmHigh, high))
    box.set_bottom(pmBox,       nz(pmLow,  low))
    box.set_right(pmBox,        bar_index + 1)
    box.set_bgcolor(pmBox,      sentFill)
    box.set_border_color(pmBox, sentBorder)

// ── Opening Range Box ─────────────────────────────────────────────────────────
var box orBox = na
if orEnds and showOR
    box.delete(orBox)
    color orFill   = isBull ? color.new(color.teal, 80) : isBear ? color.new(color.maroon, 80) : color.new(color.gray, 80)
    color orBorder = isBull ? color.teal : isBear ? color.maroon : color.gray
    orBox := box.new(nz(orStartBar, bar_index), nz(orHigh, high), bar_index, nz(orLow, low), bgcolor=orFill, border_color=orBorder, border_width=1, border_style=line.style_dashed)

// ── Market Open Label ─────────────────────────────────────────────────────────
var label openLabel = na
if mktOpen and showLabels
    label.delete(openLabel)
    string cs    = str.tostring(snap(lockedLow),  "#.##")
    string ps    = str.tostring(snap(lockedHigh), "#.##")
    string spkS  = str.tostring(minSpike,         "#.##")
    string btS   = str.tostring(bullTrigger,      "#.##")
    string beS   = str.tostring(bearTrigger,      "#.##")
    string ln1   = sentText + " | Pivot: " + str.tostring(lockedPivot, "#.##") + "  |  Spike req: " + spkS + " pt  (max $" + str.tostring(maxPremium, "#.##") + ")"
    string cFill = str.tostring(snap(lockedLow)  + maxPremium, "#.##")
    string pFill = str.tostring(snap(lockedHigh) - maxPremium, "#.##")
    string cT1   = str.tostring(snap(lockedLow)  + tp1OptionPrice, "#.##")
    string cT2   = str.tostring(snap(lockedLow)  + tp2OptionPrice, "#.##")
    string pT1   = str.tostring(snap(lockedHigh) - tp1OptionPrice, "#.##")
    string pT2   = str.tostring(snap(lockedHigh) - tp2OptionPrice, "#.##")
    string ln2   = "CALL " + cs + " spike≤" + btS + " fill@" + cFill + "  T1@" + cT1 + "($" + str.tostring(tp1OptionPrice, "#.##") + ")  T2@" + cT2 + "($" + str.tostring(tp2OptionPrice, "#.##") + ")"
    string ln3   = "PUT  " + ps + " spike≥" + beS + " fill@" + pFill + "  T1@" + pT1 + "($" + str.tostring(tp1OptionPrice, "#.##") + ")  T2@" + pT2 + "($" + str.tostring(tp2OptionPrice, "#.##") + ")"
    color  lc    = isBull ? color.green : isBear ? color.red : color.orange
    openLabel := label.new(bar_index, lockedHigh, ln1 + "\n" + ln2 + "\n" + ln3, color=lc, textcolor=color.white, style=label.style_label_down, size=size.small)

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(t2up,        "T2 ↑",        color=color.green,                linewidth=2)
plot(t1up,        "T1 ↑",        color=color.new(color.green, 30))
plot(lockedHigh,  "PM H",        color=color.new(color.aqua,  20), linewidth=1)
plot(lockedPivot, "Pivot",       color=color.yellow,               linewidth=2)
plot(lockedLow,   "PM L",        color=color.new(color.aqua,  20), linewidth=1)
plot(t1dn,        "T1 ↓",        color=color.new(color.red,   30))
plot(t2dn,        "T2 ↓",        color=color.red,                  linewidth=2)

// Trigger zone lines — where price needs to trade for entry to fire.
plot(isMkt ? bullTrigger : na, "Bull Trigger (call fill zone)", color=color.new(color.lime,   55), linewidth=1, style=plot.style_linebr)
plot(isMkt ? bearTrigger : na, "Bear Trigger (put fill zone)",  color=color.new(color.orange, 55), linewidth=1, style=plot.style_linebr)

// Option-price TP levels — where the underlying must be for the option to hit T1/T2 value.
// These are the ACTUAL exit triggers.  The gamma proxy lines above are structural reference only.
plot(isMkt ? lockedLow  + tp1OptionPrice : na, "Call TP1", color=color.new(color.green,  40), linewidth=1, style=plot.style_linebr)
plot(isMkt ? lockedLow  + tp2OptionPrice : na, "Call TP2", color=color.new(color.green,  10), linewidth=2, style=plot.style_linebr)
plot(isMkt ? lockedHigh - tp1OptionPrice : na, "Put  TP1", color=color.new(color.red,    40), linewidth=1, style=plot.style_linebr)
plot(isMkt ? lockedHigh - tp2OptionPrice : na, "Put  TP2", color=color.new(color.red,    10), linewidth=2, style=plot.style_linebr)

bgcolor(close > lockedPivot ? color.new(color.green, 93) : close < lockedPivot ? color.new(color.red, 93) : na)

// ── Status Label ──────────────────────────────────────────────────────────────
var label statusLabel = na
if barstate.islast and showStatus
    label.delete(statusLabel)
    string cs   = str.tostring(snap(lockedLow),  "#.##")
    string ps   = str.tostring(snap(lockedHigh), "#.##")
    string btS  = str.tostring(bullTrigger,      "#.##")
    string beS  = str.tostring(bearTrigger,      "#.##")
    string spkS = str.tostring(minSpike,         "#.##")
    string bFired = bullCount > 0 ? "FIRED (" + str.tostring(bullCount) + ")" : "ready"
    string eFired = bearCount > 0 ? "FIRED (" + str.tostring(bearCount) + ")" : "ready"
    string orS  = orFormed ? "formed  ↓=" + (orBrokeDown ? "YES" : "no") + "  ↑=" + (orBrokeUp ? "YES" : "no") : "not yet"
    string ln1  = "XSP Daily Lotto  |  Bias: " + sentText + "  (" + sentSymbol + ")"
    string ln2  = "CALL strike " + cs + "  |  entry ≤ " + btS + "  |  " + bFired
    string ln3  = "PUT  strike " + ps + "  |  entry ≥ " + beS + "  |  " + eFired
    int   tp1Qty   = math.max(1, math.round(contracts * tp1Pct / 100.0))
    int   tp2Qty   = contracts - tp1Qty
    float maxLoss  = maxPremium      * optMultiplier * contracts
    float tp1Gain  = (tp1OptionPrice - maxPremium) * optMultiplier * tp1Qty
    float tp2Gain  = (tp2OptionPrice - maxPremium) * optMultiplier * tp2Qty
    float fullWin  = tp1Gain + tp2Gain
    string ln4  = "P&L model (" + str.tostring(contracts) + "c × " + str.tostring(optMultiplier) + "): loss=$-" + str.tostring(maxLoss, "#") + "  TP1=$+" + str.tostring(tp1Gain, "#") + "  TP2=$+" + str.tostring(tp2Gain, "#") + "  full win=$+" + str.tostring(fullWin, "#")
    string ln5  = "Spike req: " + spkS + " pt  |  max cost $" + str.tostring(maxPremium, "#.##") + "  |  option T1/T2: $" + str.tostring(tp1OptionPrice, "#.##") + " / $" + str.tostring(tp2OptionPrice, "#.##")
    string ln6  = "OR: " + orS
    string eodStr  = eodEn ? "force-close @ " + str.tostring(eodHr) + ":" + (eodMn < 10 ? "0" : "") + str.tostring(eodMn) + " NY" : "OFF (let expire)"
    int    itmH    = (eodHr * 60 + eodMn - itmOffset) / 60
    int    itmM    = (eodHr * 60 + eodMn - itmOffset) % 60
    string itmTimeStr = str.tostring(itmH) + ":" + (itmM < 10 ? "0" : "") + str.tostring(itmM)
    string itmStatus = not itmCheckEn ? "OFF" : itmCheckFired ? (posIsItm ? "CLOSED ITM (" + str.tostring(itmDepth, "#.##") + "pt)" : "checked — OTM (held)") : "armed @ " + itmTimeStr + " NY"
    string ln7  = "Window: " + (inWindow ? "OPEN" : afterLock ? "locked (entry cutoff)" : isEod ? "EOD zone" : "outside session") + "   EOD: " + eodStr
    string ln8  = "ITM-30: " + itmStatus + (skipDeepItm ? "   deep-ITM hold ≥ " + str.tostring(deepItmPts, "#.##") + "pt" : "")
    color  sCol = isBull ? color.new(color.green, 30) : isBear ? color.new(color.maroon, 20) : color.new(color.navy, 20)
    statusLabel := label.new(bar_index, high, ln1 + "\n" + ln2 + "\n" + ln3 + "\n" + ln4 + "\n" + ln5 + "\n" + ln6 + "\n" + ln7 + "\n" + ln8, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_label_left, color=sCol, textcolor=color.white, size=size.small)

// ── TradersPost Alert Setup ────────────────────────────────────────────────────
// ALERT SETUP:
//   1. Click the clock icon → Create Alert
//   2. Condition: "XSP Daily Lotto" → "Any alert() function call"
//   3. Webhook URL: paste your TradersPost webhook URL
//   4. Message body: leave blank — the script sends full JSON automatically
//   5. Set expiry as far out as TradingView allows
//
// JSON sent (Market Orders ON):
//   BUY  entry → action:buy,  sentiment:bullish, optionType:call, strike:NNN, expiry:0DTE
//   SELL entry → action:sell, sentiment:bearish, optionType:put,  strike:NNN, expiry:0DTE
//   EXIT       → action:exit  (fires on TP1, TP2, stop, or EOD close when EOD enabled)
//
// NOTE: TradersPost option support varies by broker integration. The strike
// and optionType fields are included as metadata. Verify your broker's webhook
// format and adjust the JSON strings in the goLong/goShort blocks if needed.
