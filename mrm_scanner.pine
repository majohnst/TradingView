//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Market Roadmap Bounce (MRM) — Multi-Symbol Scanner Table
// Strategy by Jeffry Turnmire (Yellow Brick Road / Elliott Wave)
// 144/169 EMA cloud + Fibonacci retracements
//
// Usage:
//   1. Paste into TV Pine Editor → Add to chart
//   2. Enter watchlist as comma-separated symbols in Settings (max 20)
//   3. Table sorts automatically: Stage 4 → 3 → 2 → 1, freshest first
//   4. Switch the chart to whichever symbol you want to eyeball
//
// Stages:
//   1 TRENDING   — cloud directional, price trending away from cloud
//   2 RETURNING  — price declining back toward cloud (call) / rallying (put)
//   3 SETUP      — price touching or in cloud (RML event)
//   4 TRIGGERED  — bounced off cloud, closed above 61.8% fib (call) / below (put)
// ─────────────────────────────────────────────────────────────────────────────
indicator("MRM Scanner", shorttitle="MRM", overlay=false)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════
i_syms  = input.string(
              "AAPL,MSFT,NVDA,TSLA,META,AMZN,GOOG,AMD,COIN,MSTR",
              title="Watchlist (comma-separated, max 20 symbols)")
i_tf    = input.timeframe("1D",  title="Analysis timeframe")
i_lb    = input.int(60, "Swing lookback (bars)",       minval=20, maxval=250)
i_fresh = input.int(30, "Max bars since cloud touch",  minval=5,  maxval=100)

// ══════════════════════════════════════════════════════════════════════════════
// SYMBOL PARSING — explicit per-slot strings avoid function closure issues
// Fallback uses syminfo.ticker (clean ticker, no session JSON)
// ══════════════════════════════════════════════════════════════════════════════
// var forces evaluation once on bar 0 → simple array → reliable security() resolution
var _parts = str.split(str.replace_all(i_syms, " ", ""), ",")
var _n     = math.min(array.size(_parts), 20)
_fb        = "SPY"  // obvious fallback — if you see SPY in the table a slot failed to resolve

_fs0  = array.size(_parts) > 0  and str.length(array.get(_parts,  0)) > 0 ? array.get(_parts,  0) : _fb
_fs1  = array.size(_parts) > 1  and str.length(array.get(_parts,  1)) > 0 ? array.get(_parts,  1) : _fb
_fs2  = array.size(_parts) > 2  and str.length(array.get(_parts,  2)) > 0 ? array.get(_parts,  2) : _fb
_fs3  = array.size(_parts) > 3  and str.length(array.get(_parts,  3)) > 0 ? array.get(_parts,  3) : _fb
_fs4  = array.size(_parts) > 4  and str.length(array.get(_parts,  4)) > 0 ? array.get(_parts,  4) : _fb
_fs5  = array.size(_parts) > 5  and str.length(array.get(_parts,  5)) > 0 ? array.get(_parts,  5) : _fb
_fs6  = array.size(_parts) > 6  and str.length(array.get(_parts,  6)) > 0 ? array.get(_parts,  6) : _fb
_fs7  = array.size(_parts) > 7  and str.length(array.get(_parts,  7)) > 0 ? array.get(_parts,  7) : _fb
_fs8  = array.size(_parts) > 8  and str.length(array.get(_parts,  8)) > 0 ? array.get(_parts,  8) : _fb
_fs9  = array.size(_parts) > 9  and str.length(array.get(_parts,  9)) > 0 ? array.get(_parts,  9) : _fb
_fs10 = array.size(_parts) > 10 and str.length(array.get(_parts, 10)) > 0 ? array.get(_parts, 10) : _fb
_fs11 = array.size(_parts) > 11 and str.length(array.get(_parts, 11)) > 0 ? array.get(_parts, 11) : _fb
_fs12 = array.size(_parts) > 12 and str.length(array.get(_parts, 12)) > 0 ? array.get(_parts, 12) : _fb
_fs13 = array.size(_parts) > 13 and str.length(array.get(_parts, 13)) > 0 ? array.get(_parts, 13) : _fb
_fs14 = array.size(_parts) > 14 and str.length(array.get(_parts, 14)) > 0 ? array.get(_parts, 14) : _fb
_fs15 = array.size(_parts) > 15 and str.length(array.get(_parts, 15)) > 0 ? array.get(_parts, 15) : _fb
_fs16 = array.size(_parts) > 16 and str.length(array.get(_parts, 16)) > 0 ? array.get(_parts, 16) : _fb
_fs17 = array.size(_parts) > 17 and str.length(array.get(_parts, 17)) > 0 ? array.get(_parts, 17) : _fb
_fs18 = array.size(_parts) > 18 and str.length(array.get(_parts, 18)) > 0 ? array.get(_parts, 18) : _fb
_fs19 = array.size(_parts) > 19 and str.length(array.get(_parts, 19)) > 0 ? array.get(_parts, 19) : _fb

// ══════════════════════════════════════════════════════════════════════════════
// PRICE FORMATTER
// ══════════════════════════════════════════════════════════════════════════════
f_p(v) => na(v) ? "—" : str.tostring(v, "#.00")

// ══════════════════════════════════════════════════════════════════════════════
// MRM CORE — runs inside request.security() for each symbol
// Returns: [stage, dir, close, fib61, fib114, fib162, rml, cloud_top, cloud_bot, bst]
// ══════════════════════════════════════════════════════════════════════════════
f_mrm() =>
    e144     = ta.ema(close, 144)
    e169     = ta.ema(close, 169)
    ct       = math.max(e144, e169)
    cb       = math.min(e144, e169)
    bull     = e144 > e169
    in_cloud = high >= cb and low <= ct

    call_touch = in_cloud and bull
    put_touch  = in_cloud and not bull

    bst_c = nz(ta.barssince(call_touch), 999)
    bst_p = nz(ta.barssince(put_touch),  999)

    sh = ta.highest(high, i_lb)
    sl = ta.lowest(low,   i_lb)

    rml_c = ta.valuewhen(call_touch, (ct + cb) / 2, 0)
    rml_p = ta.valuewhen(put_touch,  (ct + cb) / 2, 0)

    rng_c  = sh - rml_c
    f61_c  = rml_c + 0.618  * rng_c
    f114_c = rml_c + 1.1448 * rng_c
    f162_c = rml_c + 1.618  * rng_c

    rng_p  = rml_p - sl
    f61_p  = rml_p - 0.618  * rng_p
    f114_p = rml_p - 1.1448 * rng_p
    f162_p = rml_p - 1.618  * rng_p

    stage = 0
    if bull
        if in_cloud
            stage := 3
        else if bst_c <= i_fresh
            stage := close >= f61_c ? 4 : 3
        else if close > ct
            stage := close < ta.highest(high, 15) * 0.97 ? 2 : 1
    else
        if in_cloud
            stage := 3
        else if bst_p <= i_fresh
            stage := close <= f61_p ? 4 : 3
        else if close < cb
            stage := close > ta.lowest(low, 15) * 1.03 ? 2 : 1

    dir  = bull ? "CALL" : "PUT"
    bst  = bull ? bst_c  : bst_p
    f61  = bull ? f61_c  : f61_p
    f114 = bull ? f114_c : f114_p
    f162 = bull ? f162_c : f162_p
    rml  = bull ? rml_c  : rml_p

    [stage, dir, close, f61, f114, f162, rml, ct, cb, bst]

// ══════════════════════════════════════════════════════════════════════════════
// SECURITY FETCHES — one per slot using pre-extracted symbol strings
// ══════════════════════════════════════════════════════════════════════════════
[st0,  dr0,  cl0,  f61_0,  f114_0,  f162_0,  rml0,  ct0,  cb0,  bst0]  = request.security(_fs0,  i_tf, f_mrm())
[st1,  dr1,  cl1,  f61_1,  f114_1,  f162_1,  rml1,  ct1,  cb1,  bst1]  = request.security(_fs1,  i_tf, f_mrm())
[st2,  dr2,  cl2,  f61_2,  f114_2,  f162_2,  rml2,  ct2,  cb2,  bst2]  = request.security(_fs2,  i_tf, f_mrm())
[st3,  dr3,  cl3,  f61_3,  f114_3,  f162_3,  rml3,  ct3,  cb3,  bst3]  = request.security(_fs3,  i_tf, f_mrm())
[st4,  dr4,  cl4,  f61_4,  f114_4,  f162_4,  rml4,  ct4,  cb4,  bst4]  = request.security(_fs4,  i_tf, f_mrm())
[st5,  dr5,  cl5,  f61_5,  f114_5,  f162_5,  rml5,  ct5,  cb5,  bst5]  = request.security(_fs5,  i_tf, f_mrm())
[st6,  dr6,  cl6,  f61_6,  f114_6,  f162_6,  rml6,  ct6,  cb6,  bst6]  = request.security(_fs6,  i_tf, f_mrm())
[st7,  dr7,  cl7,  f61_7,  f114_7,  f162_7,  rml7,  ct7,  cb7,  bst7]  = request.security(_fs7,  i_tf, f_mrm())
[st8,  dr8,  cl8,  f61_8,  f114_8,  f162_8,  rml8,  ct8,  cb8,  bst8]  = request.security(_fs8,  i_tf, f_mrm())
[st9,  dr9,  cl9,  f61_9,  f114_9,  f162_9,  rml9,  ct9,  cb9,  bst9]  = request.security(_fs9,  i_tf, f_mrm())
[st10, dr10, cl10, f61_10, f114_10, f162_10, rml10, ct10, cb10, bst10] = request.security(_fs10, i_tf, f_mrm())
[st11, dr11, cl11, f61_11, f114_11, f162_11, rml11, ct11, cb11, bst11] = request.security(_fs11, i_tf, f_mrm())
[st12, dr12, cl12, f61_12, f114_12, f162_12, rml12, ct12, cb12, bst12] = request.security(_fs12, i_tf, f_mrm())
[st13, dr13, cl13, f61_13, f114_13, f162_13, rml13, ct13, cb13, bst13] = request.security(_fs13, i_tf, f_mrm())
[st14, dr14, cl14, f61_14, f114_14, f162_14, rml14, ct14, cb14, bst14] = request.security(_fs14, i_tf, f_mrm())
[st15, dr15, cl15, f61_15, f114_15, f162_15, rml15, ct15, cb15, bst15] = request.security(_fs15, i_tf, f_mrm())
[st16, dr16, cl16, f61_16, f114_16, f162_16, rml16, ct16, cb16, bst16] = request.security(_fs16, i_tf, f_mrm())
[st17, dr17, cl17, f61_17, f114_17, f162_17, rml17, ct17, cb17, bst17] = request.security(_fs17, i_tf, f_mrm())
[st18, dr18, cl18, f61_18, f114_18, f162_18, rml18, ct18, cb18, bst18] = request.security(_fs18, i_tf, f_mrm())
[st19, dr19, cl19, f61_19, f114_19, f162_19, rml19, ct19, cb19, bst19] = request.security(_fs19, i_tf, f_mrm())

// ══════════════════════════════════════════════════════════════════════════════
// RESULT ARRAYS
// ══════════════════════════════════════════════════════════════════════════════
var a_sym   = array.new_string(20, "")
var a_stage = array.new_int(20, 0)
var a_dir   = array.new_string(20, "")
var a_close = array.new_float(20, na)
var a_f61   = array.new_float(20, na)
var a_f114  = array.new_float(20, na)
var a_f162  = array.new_float(20, na)
var a_rml   = array.new_float(20, na)
var a_bst   = array.new_int(20, 999)

// ══════════════════════════════════════════════════════════════════════════════
// TABLE
// ══════════════════════════════════════════════════════════════════════════════
var tbl = table.new(position.middle_right, 9, 22,
          bgcolor      = color.new(#0d1117, 5),
          border_color = #2a2a3e,
          border_width = 1,
          frame_color  = #2a2a3e,
          frame_width  = 1)

if barstate.islast

    // ── Symbol display names from pre-extracted strings ────────────────────
    array.set(a_sym,  0, _fs0)
    array.set(a_sym,  1, _fs1)
    array.set(a_sym,  2, _fs2)
    array.set(a_sym,  3, _fs3)
    array.set(a_sym,  4, _fs4)
    array.set(a_sym,  5, _fs5)
    array.set(a_sym,  6, _fs6)
    array.set(a_sym,  7, _fs7)
    array.set(a_sym,  8, _fs8)
    array.set(a_sym,  9, _fs9)
    array.set(a_sym, 10, _fs10)
    array.set(a_sym, 11, _fs11)
    array.set(a_sym, 12, _fs12)
    array.set(a_sym, 13, _fs13)
    array.set(a_sym, 14, _fs14)
    array.set(a_sym, 15, _fs15)
    array.set(a_sym, 16, _fs16)
    array.set(a_sym, 17, _fs17)
    array.set(a_sym, 18, _fs18)
    array.set(a_sym, 19, _fs19)

    // ── Populate result arrays ─────────────────────────────────────────────
    array.set(a_stage, 0, st0)
    array.set(a_dir,   0, dr0)
    array.set(a_close, 0, cl0)
    array.set(a_f61,   0, f61_0)
    array.set(a_f114,  0, f114_0)
    array.set(a_f162,  0, f162_0)
    array.set(a_rml,   0, rml0)
    array.set(a_bst,   0, bst0)

    array.set(a_stage, 1, st1)
    array.set(a_dir,   1, dr1)
    array.set(a_close, 1, cl1)
    array.set(a_f61,   1, f61_1)
    array.set(a_f114,  1, f114_1)
    array.set(a_f162,  1, f162_1)
    array.set(a_rml,   1, rml1)
    array.set(a_bst,   1, bst1)

    array.set(a_stage, 2, st2)
    array.set(a_dir,   2, dr2)
    array.set(a_close, 2, cl2)
    array.set(a_f61,   2, f61_2)
    array.set(a_f114,  2, f114_2)
    array.set(a_f162,  2, f162_2)
    array.set(a_rml,   2, rml2)
    array.set(a_bst,   2, bst2)

    array.set(a_stage, 3, st3)
    array.set(a_dir,   3, dr3)
    array.set(a_close, 3, cl3)
    array.set(a_f61,   3, f61_3)
    array.set(a_f114,  3, f114_3)
    array.set(a_f162,  3, f162_3)
    array.set(a_rml,   3, rml3)
    array.set(a_bst,   3, bst3)

    array.set(a_stage, 4, st4)
    array.set(a_dir,   4, dr4)
    array.set(a_close, 4, cl4)
    array.set(a_f61,   4, f61_4)
    array.set(a_f114,  4, f114_4)
    array.set(a_f162,  4, f162_4)
    array.set(a_rml,   4, rml4)
    array.set(a_bst,   4, bst4)

    array.set(a_stage, 5, st5)
    array.set(a_dir,   5, dr5)
    array.set(a_close, 5, cl5)
    array.set(a_f61,   5, f61_5)
    array.set(a_f114,  5, f114_5)
    array.set(a_f162,  5, f162_5)
    array.set(a_rml,   5, rml5)
    array.set(a_bst,   5, bst5)

    array.set(a_stage, 6, st6)
    array.set(a_dir,   6, dr6)
    array.set(a_close, 6, cl6)
    array.set(a_f61,   6, f61_6)
    array.set(a_f114,  6, f114_6)
    array.set(a_f162,  6, f162_6)
    array.set(a_rml,   6, rml6)
    array.set(a_bst,   6, bst6)

    array.set(a_stage, 7, st7)
    array.set(a_dir,   7, dr7)
    array.set(a_close, 7, cl7)
    array.set(a_f61,   7, f61_7)
    array.set(a_f114,  7, f114_7)
    array.set(a_f162,  7, f162_7)
    array.set(a_rml,   7, rml7)
    array.set(a_bst,   7, bst7)

    array.set(a_stage, 8, st8)
    array.set(a_dir,   8, dr8)
    array.set(a_close, 8, cl8)
    array.set(a_f61,   8, f61_8)
    array.set(a_f114,  8, f114_8)
    array.set(a_f162,  8, f162_8)
    array.set(a_rml,   8, rml8)
    array.set(a_bst,   8, bst8)

    array.set(a_stage, 9, st9)
    array.set(a_dir,   9, dr9)
    array.set(a_close, 9, cl9)
    array.set(a_f61,   9, f61_9)
    array.set(a_f114,  9, f114_9)
    array.set(a_f162,  9, f162_9)
    array.set(a_rml,   9, rml9)
    array.set(a_bst,   9, bst9)

    array.set(a_stage, 10, st10)
    array.set(a_dir,   10, dr10)
    array.set(a_close, 10, cl10)
    array.set(a_f61,   10, f61_10)
    array.set(a_f114,  10, f114_10)
    array.set(a_f162,  10, f162_10)
    array.set(a_rml,   10, rml10)
    array.set(a_bst,   10, bst10)

    array.set(a_stage, 11, st11)
    array.set(a_dir,   11, dr11)
    array.set(a_close, 11, cl11)
    array.set(a_f61,   11, f61_11)
    array.set(a_f114,  11, f114_11)
    array.set(a_f162,  11, f162_11)
    array.set(a_rml,   11, rml11)
    array.set(a_bst,   11, bst11)

    array.set(a_stage, 12, st12)
    array.set(a_dir,   12, dr12)
    array.set(a_close, 12, cl12)
    array.set(a_f61,   12, f61_12)
    array.set(a_f114,  12, f114_12)
    array.set(a_f162,  12, f162_12)
    array.set(a_rml,   12, rml12)
    array.set(a_bst,   12, bst12)

    array.set(a_stage, 13, st13)
    array.set(a_dir,   13, dr13)
    array.set(a_close, 13, cl13)
    array.set(a_f61,   13, f61_13)
    array.set(a_f114,  13, f114_13)
    array.set(a_f162,  13, f162_13)
    array.set(a_rml,   13, rml13)
    array.set(a_bst,   13, bst13)

    array.set(a_stage, 14, st14)
    array.set(a_dir,   14, dr14)
    array.set(a_close, 14, cl14)
    array.set(a_f61,   14, f61_14)
    array.set(a_f114,  14, f114_14)
    array.set(a_f162,  14, f162_14)
    array.set(a_rml,   14, rml14)
    array.set(a_bst,   14, bst14)

    array.set(a_stage, 15, st15)
    array.set(a_dir,   15, dr15)
    array.set(a_close, 15, cl15)
    array.set(a_f61,   15, f61_15)
    array.set(a_f114,  15, f114_15)
    array.set(a_f162,  15, f162_15)
    array.set(a_rml,   15, rml15)
    array.set(a_bst,   15, bst15)

    array.set(a_stage, 16, st16)
    array.set(a_dir,   16, dr16)
    array.set(a_close, 16, cl16)
    array.set(a_f61,   16, f61_16)
    array.set(a_f114,  16, f114_16)
    array.set(a_f162,  16, f162_16)
    array.set(a_rml,   16, rml16)
    array.set(a_bst,   16, bst16)

    array.set(a_stage, 17, st17)
    array.set(a_dir,   17, dr17)
    array.set(a_close, 17, cl17)
    array.set(a_f61,   17, f61_17)
    array.set(a_f114,  17, f114_17)
    array.set(a_f162,  17, f162_17)
    array.set(a_rml,   17, rml17)
    array.set(a_bst,   17, bst17)

    array.set(a_stage, 18, st18)
    array.set(a_dir,   18, dr18)
    array.set(a_close, 18, cl18)
    array.set(a_f61,   18, f61_18)
    array.set(a_f114,  18, f114_18)
    array.set(a_f162,  18, f162_18)
    array.set(a_rml,   18, rml18)
    array.set(a_bst,   18, bst18)

    array.set(a_stage, 19, st19)
    array.set(a_dir,   19, dr19)
    array.set(a_close, 19, cl19)
    array.set(a_f61,   19, f61_19)
    array.set(a_f114,  19, f114_19)
    array.set(a_f162,  19, f162_19)
    array.set(a_rml,   19, rml19)
    array.set(a_bst,   19, bst19)

    // ── Sort: stage desc, then freshness (low BST) first ──────────────────
    a_key = array.new_int(20, 0)
    for i = 0 to 19
        s = array.get(a_stage, i)
        b = math.min(array.get(a_bst, i), 999)
        array.set(a_key, i, s * 10000 + math.max(0, 999 - b))
    idx = array.sort_indices(a_key, order.descending)

    // ── Headers ───────────────────────────────────────────────────────────
    C_HDR  = #1a1a2e
    C_HTXT = color.new(color.silver, 20)
    SZ     = size.small

    table.cell(tbl, 0, 0, "Symbol",  text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "Dir",     text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_center)
    table.cell(tbl, 2, 0, "Stage",   text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 3, 0, "Price",   text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_right)
    table.cell(tbl, 4, 0, "RML 0%",  text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_right)
    table.cell(tbl, 5, 0, "61.8%",   text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_right)
    table.cell(tbl, 6, 0, "114.48%", text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_right)
    table.cell(tbl, 7, 0, "161.8%",  text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_right)
    table.cell(tbl, 8, 0, "BST",     text_color=C_HTXT, bgcolor=C_HDR, text_size=SZ, text_halign=text.align_center)

    // ── Data rows ─────────────────────────────────────────────────────────
    C_BG = color.new(#0d1117, 5)

    for row = 0 to _n - 1
        i    = array.get(idx, row)
        sym  = array.get(a_sym,   i)
        st   = array.get(a_stage, i)
        dir  = array.get(a_dir,   i)
        cl   = array.get(a_close, i)
        f61  = array.get(a_f61,   i)
        f114 = array.get(a_f114,  i)
        f162 = array.get(a_f162,  i)
        rml  = array.get(a_rml,   i)
        bst  = array.get(a_bst,   i)

        r = row + 1

        sc = st == 4 ? #00ff88 :
             st == 3 ? #ffcc00 :
             st == 2 ? #4499ff :
             st == 1 ? color.new(color.gray, 40) :
                       color.new(color.gray, 60)
        sl = st == 4 ? "4 ● TRIGGERED" :
             st == 3 ? "3 ● SETUP"      :
             st == 2 ? "2 ● RETURNING"  :
             st == 1 ? "1 ● TRENDING"   : "—"

        dc      = dir == "CALL" ? #00cc55 : #ff4455
        bst_txt = bst >= 999 ? "—" : str.tostring(bst)

        table.cell(tbl, 0, r, sym,       text_color=color.white, bgcolor=C_BG, text_size=SZ, text_halign=text.align_left)
        table.cell(tbl, 1, r, dir,       text_color=dc,          bgcolor=C_BG, text_size=SZ, text_halign=text.align_center)
        table.cell(tbl, 2, r, sl,        text_color=sc,          bgcolor=C_BG, text_size=SZ, text_halign=text.align_left)
        table.cell(tbl, 3, r, f_p(cl),   text_color=color.white, bgcolor=C_BG, text_size=SZ, text_halign=text.align_right)
        table.cell(tbl, 4, r, f_p(rml),  text_color=color.gray,  bgcolor=C_BG, text_size=SZ, text_halign=text.align_right)
        table.cell(tbl, 5, r, f_p(f61),  text_color=#ffdd66,     bgcolor=C_BG, text_size=SZ, text_halign=text.align_right)
        table.cell(tbl, 6, r, f_p(f114), text_color=#88aaff,     bgcolor=C_BG, text_size=SZ, text_halign=text.align_right)
        table.cell(tbl, 7, r, f_p(f162), text_color=#ff88aa,     bgcolor=C_BG, text_size=SZ, text_halign=text.align_right)
        table.cell(tbl, 8, r, bst_txt,   text_color=color.gray,  bgcolor=C_BG, text_size=SZ, text_halign=text.align_center)
