// ══════════════════════════════════════════════════════════════════════════════
// 3σ Credit Spread Levels  [DayTraderOrganizer]
// ══════════════════════════════════════════════════════════════════════════════
// Computes intraday remaining-time sigma bands from VIX and plots 1s/2s/3s
// levels on the chart. The 3s band is where a credit spread short leg sits
// with ~99.7% probability of expiring worthless.
//
// Use on SPX, XSP, NDX, DJX, RUT — any index with a VIX-family IV measure.
// Intended timeframes: 1m, 5m, 15m intraday.
//
// Alerts:
//   "CS Window Open"      — 11:00 AM ET entry window opens (scan Bullseye)
//   "CS Sweet Spot"       — 1:00 PM ET last-good-entry reminder
//   "Near 3s Upper/Lower" — price within X% of the short-call/put zone
//   "3s Upper/Lower Breach" — price crossed 3s; avoid new entries on that side
//
// Add to TradingView alongside the GEX + Busby indicator.
// ══════════════════════════════════════════════════════════════════════════════
//@version=5
indicator("3s Credit Spread [DTO]", overlay=true, max_lines_count=10, max_labels_count=30)

// ─── Input groups ─────────────────────────────────────────────────────────────
var G_IV   = "Volatility"
var G_DISP = "Display"
var G_WIN  = "Entry Window"
var G_ALT  = "Alerts"

// ─── Inputs ───────────────────────────────────────────────────────────────────
iv_sym      = input.symbol("CBOE:VIX", "VIX symbol", group=G_IV, tooltip="CBOE:VIX for SPX/XSP/DJX; use CBOE:VXN for NDX")
iv_override = input.float(0.0, "Manual IV % (0 = live VIX)", minval=0, maxval=200, step=0.5, group=G_IV, tooltip="Non-zero overrides the VIX feed (e.g. 16.5 for 16.5%)")

anchor_type = input.string("Current Bar", "Spot anchor", options=["Current Bar", "Session Open"], group=G_DISP, tooltip="Current Bar: dynamic sigma from live price. Session Open: anchors sigma to the 9:30 AM open — shows remaining expected move from open.")
show_1s     = input.bool(true,  "Show 1s band", group=G_DISP)
show_2s     = input.bool(true,  "Show 2s band", group=G_DISP)
show_3s     = input.bool(true,  "Show 3s band", group=G_DISP)
show_table  = input.bool(true,  "Show info table (top-right)", group=G_DISP)
strike_inc  = input.float(1.0, "Strike increment", minval=0.5, maxval=50, step=0.5, group=G_DISP, tooltip="Round 3s to nearest strike: XSP=$1, SPX=$5, NDX=$25, DJX=$1, RUT=$5")

win_open_h  = input.int(11, "Window open  — hour ET",   minval=9,  maxval=14, group=G_WIN)
win_open_m  = input.int( 0, "Window open  — minute ET", minval=0,  maxval=59, step=15, group=G_WIN)
win_close_h = input.int(14, "Window close — hour ET",   minval=10, maxval=16, group=G_WIN)
win_close_m = input.int(30, "Window close — minute ET", minval=0,  maxval=59, step=15, group=G_WIN)
sweet_h     = input.int(13, "Sweet spot hour ET",   minval=10, maxval=15, group=G_WIN)
sweet_m     = input.int( 0, "Sweet spot minute ET", minval=0,  maxval=59, step=15, group=G_WIN)

alert_pct   = input.float(0.30, "Alert within % of 3s", minval=0.05, maxval=5.0, step=0.05, group=G_ALT, tooltip="Fire Near-3s alert when price is within this % of the 3s strike zone")

// ─── Time helpers (America/New_York) ─────────────────────────────────────────
ET          = "America/New_York"
et_h        = hour(time, ET)
et_m        = minute(time, ET)
et_min      = et_h * 60 + et_m

OPEN_MIN    = 9  * 60 + 30     // 570   9:30 AM
CLOSE_MIN   = 16 * 60          // 960   4:00 PM
TRADING_HRS = 6.5

is_rth      = et_min >= OPEN_MIN and et_min < CLOSE_MIN
is_open_bar = et_min == OPEN_MIN
mins_rem    = float(math.max(CLOSE_MIN - et_min, 1))
hours_rem   = mins_rem / 60.0

in_window   = is_rth and et_min >= win_open_h * 60 + win_open_m and et_min <= win_close_h * 60 + win_close_m
is_win_open = is_rth and et_min == win_open_h * 60 + win_open_m
is_sweet    = is_rth and et_min == sweet_h * 60 + sweet_m

// ─── Session-open anchor ─────────────────────────────────────────────────────
var float open_price = na
if is_open_bar or (is_rth and na(open_price))
    open_price := close
if not is_rth
    open_price := na

spot = anchor_type == "Session Open" ? nz(open_price, close) : close

// ─── IV / VIX ────────────────────────────────────────────────────────────────
vix_live = request.security(iv_sym, "D", close, ignore_invalid_symbol=true)
iv       = iv_override > 0 ? iv_override / 100.0 : nz(vix_live, 16.0) / 100.0

// ─── Sigma calculation ────────────────────────────────────────────────────────
// s_remaining = spot x IV x sqrt(hours_remaining / (TRADING_HRS x 252))
sigma = spot * iv * math.sqrt(hours_rem / (TRADING_HRS * 252.0))

u1 = spot + 1.0 * sigma
l1 = spot - 1.0 * sigma
u2 = spot + 2.0 * sigma
l2 = spot - 2.0 * sigma
u3 = spot + 3.0 * sigma
l3 = spot - 3.0 * sigma

// Round to nearest tradable strike
u3_strike = math.ceil(u3  / strike_inc) * strike_inc
l3_strike = math.floor(l3 / strike_inc) * strike_inc

// ─── Plots ───────────────────────────────────────────────────────────────────
C1  = color.new(color.blue,   65)
C2  = color.new(color.orange, 45)
C3U = color.new(color.red,    20)
C3L = color.new(color.lime,   20)

p_u1 = plot(is_rth and show_1s ? u1 : na, "1s Upper", C1,  1, plot.style_line)
p_l1 = plot(is_rth and show_1s ? l1 : na, "1s Lower", C1,  1, plot.style_line)
p_u2 = plot(is_rth and show_2s ? u2 : na, "2s Upper", C2,  1, plot.style_line)
p_l2 = plot(is_rth and show_2s ? l2 : na, "2s Lower", C2,  1, plot.style_line)
p_u3 = plot(is_rth and show_3s ? u3 : na, "3s Upper", C3U, 2, plot.style_line)
p_l3 = plot(is_rth and show_3s ? l3 : na, "3s Lower", C3L, 2, plot.style_line)

// Soft fill between 2s and 3s (the short-leg zone)
fill(p_u3, p_u2, color.new(color.red,  93), "3s-2s call zone")
fill(p_l2, p_l3, color.new(color.lime, 93), "3s-2s put zone")

// Entry window background tint
bgcolor(in_window ? color.new(color.teal, 92) : na, title="Entry window")

// ─── Format helper ────────────────────────────────────────────────────────────
_fmt(v) =>
    str.tostring(math.round(v, 2))

// ─── Labels ──────────────────────────────────────────────────────────────────
if is_win_open
    label.new(bar_index, u3, "SELL CALL >= " + _fmt(u3_strike) + "\n3s upper  1s=" + _fmt(sigma), style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.small)
    label.new(bar_index, l3, "SELL PUT <= " + _fmt(l3_strike) + "\n3s lower", style=label.style_label_up, color=color.new(color.lime, 10), textcolor=color.black, size=size.small)

if is_sweet
    label.new(bar_index, u3, "Last entry\nCALL >= " + _fmt(u3_strike) + "  PUT <= " + _fmt(l3_strike), style=label.style_label_left, color=color.new(color.teal, 10), textcolor=color.white, size=size.small)

// ─── Info table ──────────────────────────────────────────────────────────────
var tbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 55), border_color=color.new(color.gray, 40), border_width=1, frame_color=color.new(color.gray, 30), frame_width=1)

if show_table and is_rth and barstate.islast
    win_lbl = in_window ? "WINDOW ACTIVE" : (et_min < win_open_h * 60 + win_open_m ? "before window" : "window closed")
    win_clr = in_window ? color.lime : color.gray
    hrs_clr = hours_rem < 2.0 ? color.orange : (hours_rem < 3.5 ? color.yellow : color.white)
    table.cell(tbl, 0, 0, "3s Credit Spread",                              text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 0, win_lbl,                                         text_color=win_clr,      text_size=size.small)
    table.cell(tbl, 0, 1, "Spot",                                          text_color=color.gray,   text_size=size.small)
    table.cell(tbl, 1, 1, _fmt(spot),                                      text_color=color.white,  text_size=size.small)
    table.cell(tbl, 0, 2, "1s remaining",                                  text_color=color.gray,   text_size=size.small)
    table.cell(tbl, 1, 2, _fmt(sigma),                                     text_color=color.blue,   text_size=size.small)
    table.cell(tbl, 0, 3, "3s CALL short",                                 text_color=color.gray,   text_size=size.small)
    table.cell(tbl, 1, 3, _fmt(u3_strike),                                 text_color=color.red,    text_size=size.small)
    table.cell(tbl, 0, 4, "3s PUT short",                                  text_color=color.gray,   text_size=size.small)
    table.cell(tbl, 1, 4, _fmt(l3_strike),                                 text_color=color.lime,   text_size=size.small)
    table.cell(tbl, 0, 5, "Hours left",                                    text_color=color.gray,   text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(math.round(hours_rem, 1)) + "h",   text_color=hrs_clr,      text_size=size.small)
    table.cell(tbl, 0, 6, "IV (VIX %)",                                    text_color=color.gray,   text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(math.round(iv * 100, 1)) + "%",    text_color=color.yellow, text_size=size.small)

// ─── Alert conditions ────────────────────────────────────────────────────────
near_u3   = is_rth and close >= u3 * (1.0 - alert_pct / 100.0) and close < u3
near_l3   = is_rth and close <= l3 * (1.0 + alert_pct / 100.0) and close > l3
breach_u3 = is_rth and close >= u3
breach_l3 = is_rth and close <= l3

alertcondition(is_win_open,                "CS Window Open",         "3s credit spread window opened — check Bullseye and scan for entry")
alertcondition(is_sweet,                   "CS Sweet Spot",          "1 PM ET sweet spot — last good entry for 0DTE 3s credit spread, check live credit")
alertcondition(near_u3 and in_window,      "Near 3s Upper (window)", "Price approaching 3s CALL zone in entry window — review credit spread entry")
alertcondition(near_l3 and in_window,      "Near 3s Lower (window)", "Price approaching 3s PUT zone in entry window — review credit spread entry")
alertcondition(near_u3 or near_l3,         "Near 3s (any)",          "Price near 3s band — check Bullseye credit spread card for live credit")
alertcondition(breach_u3,                  "3s Upper Breached",      "Price crossed ABOVE 3s upper — avoid new call spread entries")
alertcondition(breach_l3,                  "3s Lower Breached",      "Price crossed BELOW 3s lower — avoid new put spread entries")
