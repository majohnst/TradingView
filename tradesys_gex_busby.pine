// © TradeTracker — https://github.com/mjohnston
// Generated by TradeTracker GEX Dashboard — paste output from the
// 📋 "Copy GEX levels for TradingView" button into Data Input below.
//
// Workflow:
//   1. Open TradeTracker dashboard → Tools tab → Bullseye GEX section
//   2. Enter symbol (XSP, SPY, etc.) → click Scan
//   3. Click "📋 Copy GEX levels for TradingView"
//   4. Open this indicator's settings → Data Input → paste
//
// Levels plotted:
//   GEX:   Bullseye · Gamma Flip · Call Wall · Put Wall · Max Pain
//   Adv:   Expected Move ±1σ · Flip Zones (all zero-crossings)
//   Top N: Top N strikes by |net-GEX|
//   Busby: PM H/L · OR H/L · Pivot · T1/T2 targets (if available)
//
// MIT License — attribution appreciated but not required.
//@version=6

indicator(
    "TradeTracker GEX + Busby",
    overlay          = true,
    max_lines_count  = 50,
    max_labels_count = 50
)

// ── Input groups ──────────────────────────────────────────────────────────────
const string G_INPUT = "Data Input"
const string G_GEX   = "GEX Key Levels"
const string G_ADV   = "Advanced"
const string G_TOP   = "GEX Top Strikes"
const string G_BUSBY = "Busby Levels"
const string G_STYLE = "Style"
const string G_LABEL = "Label Settings"

// ── Data ──────────────────────────────────────────────────────────────────────
txt = input.text_area(
    defval  = "",
    title   = "Paste TradeTracker GEX Data",
    group   = G_INPUT,
    tooltip = "TradeTracker → Tools → Bullseye GEX → Scan → 📋 Copy GEX levels for TradingView → paste here."
)

// ── GEX Key Levels ────────────────────────────────────────────────────────────
color_bullseye  = input.color(color.yellow,    "Bullseye",          group = G_GEX, inline = "bs")
show_bullseye   = input.bool (true,       " ", group = G_GEX, inline = "bs",  tooltip = "Max-gamma strike — where dealer delta-hedging is strongest and price is most likely to pin.")
color_flip      = input.color(#ff8a65,         "Gamma Flip",        group = G_GEX, inline = "gf")
show_flip       = input.bool (true,       " ", group = G_GEX, inline = "gf",  tooltip = "Interpolated cumulative-GEX zero-crossing. Dealers dampen moves above this level; amplify moves below it.")
color_call_wall = input.color(color.lime,      "Call Wall",         group = G_GEX, inline = "cw")
show_call_wall  = input.bool (true,       " ", group = G_GEX, inline = "cw",  tooltip = "Strike with the highest call open interest — strong overhead resistance.")
color_put_wall  = input.color(color.red,       "Put Wall",          group = G_GEX, inline = "pw")
show_put_wall   = input.bool (true,       " ", group = G_GEX, inline = "pw",  tooltip = "Strike with the highest put open interest — strong downside support.")
color_max_pain  = input.color(color.white,     "Max Pain",          group = G_GEX, inline = "mp")
show_max_pain   = input.bool (true,       " ", group = G_GEX, inline = "mp",  tooltip = "Strike that minimizes total intrinsic-value payout across all open options — where option sellers profit most at expiry.")

// ── Advanced ──────────────────────────────────────────────────────────────────
color_em    = input.color(color.gray,   "Expected Move ±1σ", group = G_ADV, inline = "em")
show_em     = input.bool (true,    " ", group = G_ADV, inline = "em",  tooltip = "VIX-derived 1-standard-deviation expected move for this expiry. Upper and lower bounds.")
color_flipz = input.color(color.purple, "Flip Zones",        group = G_ADV, inline = "fz")
show_flipz  = input.bool (true,    " ", group = G_ADV, inline = "fz",  tooltip = "All cumulative net-GEX zero-crossings within the ±10% strike band.")

// ── GEX Top Strikes ───────────────────────────────────────────────────────────
top_n     = input.int  (5,        "Show Top N Strikes", minval = 0, maxval = 10, group = G_TOP,
                         tooltip = "Number of top strikes by absolute net-GEX to plot (0 = hide all).")
color_top = input.color(#4fc3f7,  "Strike Color",                               group = G_TOP)

// ── Busby Levels ──────────────────────────────────────────────────────────────
color_pm_h  = input.color(#ff6b6b, "PM High",    group = G_BUSBY, inline = "pmh")
show_pm_h   = input.bool (true, " ", group = G_BUSBY, inline = "pmh", tooltip = "Pre-market session high (SPY proxy for index symbols).")
color_pm_l  = input.color(#66bb6a, "PM Low",     group = G_BUSBY, inline = "pml")
show_pm_l   = input.bool (true, " ", group = G_BUSBY, inline = "pml", tooltip = "Pre-market session low.")
color_or_h  = input.color(#80deea, "OR High",    group = G_BUSBY, inline = "orh")
show_or_h   = input.bool (true, " ", group = G_BUSBY, inline = "orh", tooltip = "Opening-range high — first 5 minutes of RTH.")
color_or_l  = input.color(#80deea, "OR Low",     group = G_BUSBY, inline = "orl")
show_or_l   = input.bool (true, " ", group = G_BUSBY, inline = "orl", tooltip = "Opening-range low.")
color_pivot = input.color(#ffd54f, "Pivot",      group = G_BUSBY, inline = "pvt")
show_pivot  = input.bool (true, " ", group = G_BUSBY, inline = "pvt", tooltip = "Busby pivot — prior-day range midpoint snapped to the ATR-derived grid.")
color_t1    = input.color(#ef9a9a, "T1 ↑ / ↓",  group = G_BUSBY, inline = "t1")
show_t1     = input.bool (true, " ", group = G_BUSBY, inline = "t1",  tooltip = "T1 extension targets (one grid step above and below pivot).")
color_t2    = input.color(#e57373, "T2 ↑ / ↓",  group = G_BUSBY, inline = "t2")
show_t2     = input.bool (true, " ", group = G_BUSBY, inline = "t2",  tooltip = "T2 extension targets (two grid steps above and below pivot).")

// ── Style ─────────────────────────────────────────────────────────────────────
line_width       = input.int   (1,        "Line Width",   minval = 1, maxval = 4, group = G_STYLE)
line_style_input = input.string("Dashed", "Line Style",   options = ["Solid", "Dashed", "Dotted"], group = G_STYLE)
extend_input     = input.string("Right",  "Extend Lines", options = ["Both", "Right", "Left", "None"], group = G_STYLE)
max_dist_pct     = input.float (3.0, "Max Level Distance (%)", minval = 0.0, maxval = 25.0, step = 0.5, group = G_STYLE,
                                 tooltip = "Skip levels more than this % from the current close — prevents distant flip zones from squashing the chart view. Good defaults: 3% for 0DTE, 5% for weekly, 10%+ for monthly. Set to 0 to disable.")

// ── Label Settings ────────────────────────────────────────────────────────────
label_size_input = input.string("small", "Label Size",     options = ["tiny", "small", "normal", "large", "huge"], group = G_LABEL)
label_offset     = input.int   (45,      "Label Offset",   minval = -200, maxval = 500, group = G_LABEL,
                                 tooltip = "Bars to the right (positive) or left (negative) of the current bar.")
label_side       = input.string("Right", "Label Side",     options = ["Right", "Left"], group = G_LABEL)

// ── Style helpers ─────────────────────────────────────────────────────────────
f_line_style() =>
    line_style_input == "Solid"  ? line.style_solid  :
     line_style_input == "Dotted" ? line.style_dotted :
     line.style_dashed

f_extend() =>
    extend_input == "Both"  ? extend.both  :
     extend_input == "Right" ? extend.right :
     extend_input == "Left"  ? extend.left  :
     extend.none

f_label_size() =>
    label_size_input == "tiny"   ? size.tiny   :
     label_size_input == "large"  ? size.large  :
     label_size_input == "huge"   ? size.huge   :
     label_size_input == "normal" ? size.normal :
     size.small

f_label_bar() =>
    label_side == "Left" ? bar_index - math.abs(label_offset) : bar_index + label_offset

f_label_style() =>
    label_side == "Left" ? label.style_label_right : label.style_none

// ── Digit helper ──────────────────────────────────────────────────────────────
is_digit(string ch) =>
    ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or
     ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"

// ── Parser: find KEY and return the $value that follows it ───────────────────
// KEY must include any trailing space, e.g. "BULLSEYE: " so that
// "TOP1: " correctly distinguishes from "TOP10: ".
parse_key(string src, string key) =>
    float result = na
    int   kIdx   = str.pos(src, key)
    if not na(kIdx)
        string sub  = str.substring(src, kIdx + str.length(key))
        int    dIdx = str.pos(sub, "$")
        if not na(dIdx)
            string after  = str.substring(sub, dIdx + 1)
            string numStr = ""
            bool   done   = false
            for i = 0 to str.length(after) - 1
                if not done
                    string ch = str.substring(after, i, i + 1)
                    if is_digit(ch) or ch == "."
                        numStr := numStr + ch
                    else if ch == ","
                        numStr := numStr   // skip thousands-separator commas
                    else
                        done := true
            if str.length(numStr) > 0
                result := str.tonumber(numStr)
    result

// ── Level accumulator ─────────────────────────────────────────────────────────
// Deduplicates levels within ±0.50 of an existing entry by merging labels.
add_level(array<float> p, array<string> l, array<color> c,
          float price, string lbl, color col) =>
    bool merged   = false
    // Distance filter — skip levels beyond max_dist_pct % of current close.
    // When max_dist_pct == 0 the filter is disabled and all levels are drawn.
    bool in_range = not na(price) and price > 0.0 and
                     (max_dist_pct <= 0.0 or
                      math.abs(price - close) / close * 100.0 <= max_dist_pct)
    if in_range
        if array.size(p) > 0
            for i = 0 to array.size(p) - 1
                if not merged and math.abs(array.get(p, i) - price) < 0.50
                    array.set(l, i, array.get(l, i) + " / " + lbl)
                    merged := true
        if not merged
            array.push(p, price)
            array.push(l, lbl)
            array.push(c, col)
    merged

// ── State ─────────────────────────────────────────────────────────────────────
var array<line>  drawn_lines  = array.new_line()
var array<label> drawn_labels = array.new_label()

// ── Main: redraw on last bar whenever input changes ───────────────────────────
if barstate.islast and str.length(txt) > 4

    // Clear previous drawings
    if drawn_lines.size() > 0
        for i = 0 to drawn_lines.size() - 1
            line.delete(drawn_lines.get(i))
    drawn_lines.clear()

    if drawn_labels.size() > 0
        for i = 0 to drawn_labels.size() - 1
            label.delete(drawn_labels.get(i))
    drawn_labels.clear()

    // Accumulator arrays (local to this block — re-created on each redraw)
    array<float>  acc_prices = array.new_float()
    array<string> acc_labels = array.new_string()
    array<color>  acc_colors = array.new_color()

    // ── GEX key levels ────────────────────────────────────────────────────────
    if show_bullseye
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "BULLSEYE: "),   "🎯 Bullseye", color_bullseye)
    if show_flip
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "GAMMA_FLIP: "), "Γ Flip",      color_flip)
    if show_call_wall
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "CALL_WALL: "),  "Call Wall",   color_call_wall)
    if show_put_wall
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "PUT_WALL: "),   "Put Wall",    color_put_wall)
    if show_max_pain
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "MAX_PAIN: "),   "Max Pain",    color_max_pain)

    // ── Expected Move ─────────────────────────────────────────────────────────
    if show_em
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "EM_HIGH: "), "+1σ EM", color_em)
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "EM_LOW: "),  "-1σ EM", color_em)

    // ── Flip zones (numbered FLIP_ZONE1 … FLIP_ZONE10) ───────────────────────
    if show_flipz
        for fi = 1 to 10
            float fv = parse_key(txt, "FLIP_ZONE" + str.tostring(fi) + ": ")
            if not na(fv)
                add_level(acc_prices, acc_labels, acc_colors,
                          fv, "Flip " + str.tostring(fi), color_flipz)

    // ── GEX Top N strikes (TOP1 … TOP10) ─────────────────────────────────────
    if top_n > 0
        for ti = 1 to top_n
            float tv = parse_key(txt, "TOP" + str.tostring(ti) + ": ")
            if not na(tv)
                add_level(acc_prices, acc_labels, acc_colors,
                          tv, "#" + str.tostring(ti), color_top)

    // ── Busby levels ──────────────────────────────────────────────────────────
    if show_pm_h
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "PM_HIGH: "), "PM H", color_pm_h)
    if show_pm_l
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "PM_LOW: "),  "PM L", color_pm_l)
    if show_or_h
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "OR_HIGH: "), "OR H", color_or_h)
    if show_or_l
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "OR_LOW: "),  "OR L", color_or_l)
    if show_pivot
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "PIVOT: "),   "Pivot",color_pivot)
    if show_t1
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "T1_UP: "), "T1↑", color_t1)
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "T1_DN: "), "T1↓", color_t1)
    if show_t2
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "T2_UP: "), "T2↑", color_t2)
        add_level(acc_prices, acc_labels, acc_colors,
                  parse_key(txt, "T2_DN: "), "T2↓", color_t2)

    // ── Draw all accumulated levels ───────────────────────────────────────────
    int lbl_bar = f_label_bar()
    if acc_prices.size() > 0
        for i = 0 to acc_prices.size() - 1
            float  prc = acc_prices.get(i)
            string lbl = acc_labels.get(i)
            color  col = acc_colors.get(i)
            line ln = line.new(
                bar_index - 1, prc, bar_index, prc,
                extend = f_extend(),
                color  = col,
                style  = f_line_style(),
                width  = line_width
            )
            label lb = label.new(
                lbl_bar, prc,
                lbl + "  " + str.tostring(prc, format.mintick),
                style     = f_label_style(),
                textcolor = col,
                color     = #363a4500,
                size      = f_label_size()
            )
            drawn_lines.push(ln)
            drawn_labels.push(lb)
